---
import BaseLayout from '../layouts/BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import Terminal from '../components/Terminal.astro';
import Proyectos from '../components/Proyectos.astro';
---

<BaseLayout title="Vasile Andrei Popan — DevOps / DevSecOps">
  <Sidebar />

  <main class="main-content">

    <!-- INICIO -->
    <section class="page-section" id="inicio" data-section="inicio">
      <div class="section-inner hero-inner">
        <div class="hero-meta">
          <span class="hero-tag">$ ssh admin@vapopan.dev</span>
          <span class="hero-tag">EST. 2025</span>
        </div>
        <Terminal />
        <p class="hero-hint">
          <span class="hint-arrow">↓</span>
          scroll para explorar
        </p>
      </div>
    </section>

    <!-- HACKATHONS -->
    <section class="page-section" id="hackathons" data-section="hackathons">
      <div class="section-inner proyectos-inner">
        <Proyectos />
      </div>
    </section>

    <!-- ACTIVITIES (placeholder) -->
    <section class="page-section" id="activities" data-section="activities">
      <div class="section-inner">
        <div class="coming-soon">
          <span class="cs-prompt">admin@vapopan:~$ cat activities/index.md</span>
          <span class="cs-output">// próximamente — 0xD3C0D3, CTFs, workshops</span>
          <span class="t-cursor-inline"></span>
        </div>
      </div>
    </section>

    <!-- PROYECTOS (placeholder) -->
    <section class="page-section" id="proyectos" data-section="proyectos">
      <div class="section-inner">
        <div class="coming-soon">
          <span class="cs-prompt">admin@vapopan:~$ ls proyectos/</span>
          <span class="cs-output">// próximamente — infra, homelab, scripts</span>
          <span class="t-cursor-inline"></span>
        </div>
      </div>
    </section>

    <!-- ABOUT (placeholder) -->
    <section class="page-section" id="about" data-section="about">
      <div class="section-inner">
        <div class="coming-soon">
          <span class="cs-prompt">admin@vapopan:~$ cat about.txt</span>
          <span class="cs-output">// próximamente — about & contacto</span>
          <span class="t-cursor-inline"></span>
        </div>
      </div>
    </section>

  </main>
</BaseLayout>

<style>
  .main-content {
    margin-left: var(--sidebar-w);
    height: 100vh;
    overflow-y: scroll;
    scroll-snap-type: y mandatory;
    scroll-behavior: smooth;
    background-image: radial-gradient(circle, var(--border) 1px, transparent 1px);
    background-size: 28px 28px;
  }

  .page-section {
    scroll-snap-align: start;
    scroll-snap-stop: always;
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  /* Vignette */
  .page-section::before {
    content: '';
    position: absolute; inset: 0;
    background: radial-gradient(ellipse 75% 75% at 50% 50%, transparent 30%, var(--bg) 100%);
    pointer-events: none;
    z-index: 0;
  }

  .section-inner {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 860px;
    padding: 0 48px;
  }

  /* Hero */
  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    max-width: 800px;
  }

  .hero-meta {
    width: 100%;
    max-width: 760px;
    display: flex;
    justify-content: space-between;
  }

  .hero-tag {
    font-size: 11px;
    color: var(--muted);
    letter-spacing: 0.8px;
    font-family: var(--font);
  }

  .hero-hint {
    font-size: 11px;
    color: var(--muted);
    animation: fadeIn 1.5s ease 5s both;
    display: flex;
    align-items: center;
    gap: 5px;
    font-family: var(--font);
  }

  .hint-arrow {
    color: var(--accent-dim);
    animation: bounce 1.8s ease-in-out 5s infinite;
  }

  /* Hackathons section */
  #hackathons { align-items: center; }
  .proyectos-inner {
    width: 100%;
    max-width: 820px;
    padding: 0 16px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .proyectos-inner > * { width: 100%; }

  /* Coming soon */
  .coming-soon {
    display: flex;
    flex-direction: column;
    gap: 10px;
    font-family: var(--font);
  }
  .cs-prompt { font-size: 13px; color: var(--text-dim); }
  .cs-output  { font-size: 13px; color: var(--muted); padding-left: 4px; }

  .t-cursor-inline {
    display: inline-block;
    width: 8px; height: 14px;
    background: var(--accent);
    vertical-align: middle;
    margin-left: 2px;
    animation: blink 1s step-end infinite;
    opacity: 0.6;
  }

  /* ── MOBILE ── */
  @media (max-width: 768px) {
    .main-content {
      margin-left: 0;
      /* extra bottom padding for the mobile nav bar */
      padding-bottom: 60px;
    }

    .page-section {
      /* on mobile, allow a bit of breathing room */
      min-height: 100vh;
      height: auto;
      padding: 24px 0;
    }

    .section-inner {
      padding: 0 20px;
      max-width: 100%;
    }

    .hero-inner { max-width: 100%; }

    .hero-meta { display: none; } /* too cramped on mobile */

    .proyectos-inner { padding: 0 12px; }
  }

  @keyframes blink   { 0%, 100% { opacity: 0.6; } 50% { opacity: 0; } }
  @keyframes bounce  { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(4px); } }
  @keyframes fadeIn  { from { opacity: 0; } to { opacity: 1; } }
</style>

<script>
  const sections = document.querySelectorAll<HTMLElement>('.page-section');
  // Select both sidebar nav items and mobile nav items
  const navLinks = document.querySelectorAll<HTMLAnchorElement>('.nav-item, .mn-item');

  function setActive(id: string | null) {
    navLinks.forEach(link => {
      const sec = link.getAttribute('data-section');
      const isActive = sec === id;
      link.classList.toggle('active', isActive);
      // sidebar bar indicator
      const bar = link.querySelector('.nav-active-bar') as HTMLElement | null;
      if (bar) bar.style.display = isActive ? 'block' : 'none';
      // sidebar icon
      const icon = link.querySelector('.nav-icon') as HTMLElement | null;
      if (icon) icon.textContent = isActive ? '▶' : '›';
    });
  }

  const observer = new IntersectionObserver(
    entries => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const id = entry.target.getAttribute('data-section');
          setActive(id);
          history.replaceState(null, '', id === 'inicio' ? '/' : `#${id}`);
        }
      });
    },
    { threshold: 0.5 }
  );

  sections.forEach(s => observer.observe(s));

  navLinks.forEach(link => {
    link.addEventListener('click', e => {
      const sec = link.getAttribute('data-section') ?? 'inicio';
      const target = document.getElementById(sec);
      if (target) {
        e.preventDefault();
        target.scrollIntoView({ behavior: 'smooth' });
      }
    });
  });
</script>