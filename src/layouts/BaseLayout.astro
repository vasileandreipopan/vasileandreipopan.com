---
export interface Props {
  title?: string;
}
const { title = "Vasile Andrei Popan" } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover.0" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,300;0,400;0,500;0,700;1,400&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      :root {
        /* Page: warm off-white / paper — professional, clean, legible */
        --bg:           #f5f2ed;
        --bg-panel:     #ede9e2;
        --bg-card:      #faf8f4;
        --border:       #dbd5cb;
        --border-hi:    #c8c0b4;

        /* Accent: muted forest green — infra/DevOps feel, not neon */
        --accent:       #2d6a4f;
        --accent-dim:   #52796f;
        --accent-subtle:rgba(45, 106, 79, 0.09);

        /* Text */
        --text:         #1c1b18;
        --text-dim:     #6a6760;
        --muted:        #9e9890;

        /* Terminal window: dark island inside the light page */
        --term-bg:      #191917;
        --term-panel:   #131311;
        --term-border:  #2c2c28;
        --term-border-hi:#3a3a34;
        --term-text:    #d2cfc6;
        --term-dim:     #787570;
        --term-green:   #4ec994;
        --term-green-dim:#2a6a48;
        --term-amber:   #d4a74a;

        --sidebar-w: 220px;
        --font: 'JetBrains Mono', 'Fira Code', monospace;
      }

      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      html, body {
        height: 100%;
        background: var(--bg);
        color: var(--text);
        font-family: var(--font);
        font-size: 14px;
        line-height: 1.6;
        overflow: hidden;
      }

      ::selection {
        background: var(--accent-subtle);
        color: var(--accent);
      }

      ::-webkit-scrollbar { width: 6px; }
      ::-webkit-scrollbar-track { background: var(--bg-panel); }
      ::-webkit-scrollbar-thumb { background: var(--border-hi); border-radius: 3px; }

      a { color: var(--accent); text-decoration: none; }
      a:hover { text-decoration: underline; }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>