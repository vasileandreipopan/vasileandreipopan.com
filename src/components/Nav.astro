<style>
  .nav-outer {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    height: var(--nav-h);
    background: var(--black);
    border-bottom: 3px double var(--white);
  }

  .nav {
    max-width: var(--max-w);
    margin: 0 auto;
    padding: 0 1.5rem;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .nav-name {
    color: var(--white);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-sys);
    font-size: 0.72rem;
  }

  .nav-links span { color: var(--gray); }

  .nav-links a {
    color: var(--gray);
    text-decoration: none;
    padding: 0.1rem 0.25rem;
  }
  .nav-links a:hover {
    background: var(--white);
    color: var(--black);
  }
</style>