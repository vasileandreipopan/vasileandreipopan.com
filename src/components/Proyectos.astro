---
interface MediaItem {
  type: 'img' | 'video';
  src: string;
  alt?: string;
}

interface Hackathon {
  id: string;
  date: string;
  title: string;
  org: string;
  desc: string;
  highlight: string;
  tags: string[];
  links: { label: string; href: string }[];
  media: MediaItem[];
}

const hackathons: Hackathon[] = [
  {
    id: "hackupc2026",
    date: "2026",
    title: "? — Coming Soon",
    org: "HackUPC 2026",
    desc: "Coming soon...",
    highlight: "",
    tags: [],
    links: [],
    media: [],
  },
  {
    id: "lerobot",
    date: "Jan 2026",
    title: "LE-PICASSO",
    org: "NVIDIA · LeRobot Bilbao Hackathon",
    desc: "Voice-controlled robotic arm via webapp. An AI model processed audio, extracted drawing instructions using NER, and sent commands to a physical robot arm in real time.",
    highlight: "End-to-end pipeline: NLP + robotics + web.",
    tags: ["NER", "LeRobot", "Robotics", "Webapp"],
    links: [
      { label: "repo", href: "https://github.com/vasileandreipopan/lePicasso" },
      { label: "video", href: "https://www.youtube.com/watch?v=32cV6rU5I34" },
    ],
    media: [
      { type: "img", src: "/media/lerobot.png", alt: "Presentation" },
      { type: "img", src: "/media/lerobot2.jpg", alt: "Team" },
      { type: "img", src: "/media/lerobot3.jpg", alt: "Robot" },
    ],
  },
  {
    id: "nasa",
    date: "Oct 2025",
    title: "Rookie Rockets: Exovision",
    org: "NASA Space Apps Challenge 2025",
    desc: "AI-powered web platform to detect exoplanets using NASA's Kepler dataset. Educational mode for the public + professional mode for researchers to upload and analyze real light curves.",
    highlight: "Coordinator & full-stack contributor: AI, frontend, project direction.",
    tags: ["Python", "ML", "NASA Kepler", "React"],
    links: [
      { label: "+info", href: "https://www.spaceappschallenge.org/2025/find-a-team/rookie-rockets/" },
    ],
    media: [
      { type: "img", src: "/media/nasaHackathon-team.jpeg", alt: "Team" },
      { type: "img", src: "/media/decodeNasaHackathon.jpeg", alt: "0xdecode" },
      { type: "img", src: "/media/presentationNasa.jpeg", alt: "Presentation" },
    ],
  },
  {
    id: "hackupc2024",
    date: "May 2024",
    title: "Travel Recommender",
    org: "HackUPC 2024 · Skyscanner Challenge",
    desc: "Web app helping groups of friends find the perfect travel destination based on preferences, budget, and sustainability.",
    highlight: "My first hackathon — where it all started.",
    tags: ["HTML/CSS/JS", "Java", "API Integration"],
    links: [
      { label: "repo", href: "https://github.com/pablo10diez2/hackupc" },
    ],
    media: [{ type: "img", src: "/media/hackupc2025.jpeg", alt: "Presentation" },],
  },
];
---

<div class="hk-shell">

  <!-- Nav header -->
  <div class="hk-nav">
    <div class="hk-prompt">
      <span class="hk-u">admin</span><span class="hk-s"> : ~ $ </span><span class="hk-c">ls hackathons/</span>
    </div>
    <div class="hk-nav-right">
      <button class="hk-arr-btn" id="hkPrev" disabled aria-label="Anterior">←</button>
      <span class="hk-counter"><span id="hkCur">01</span><span class="hk-csep"> / </span><span>{String(hackathons.length).padStart(2,'0')}</span></span>
      <button class="hk-arr-btn" id="hkNext" aria-label="Siguiente">→</button>
    </div>
  </div>

  <!-- Slides -->
  <div class="hk-slides" id="hkSlides">
    {hackathons.map((h, i) => (
      <div class={`hk-slide ${i === 0 ? 'active' : ''}`} data-index={i}>

        <!-- Two column card -->
        <div class="hk-card">

          <!-- LEFT: photo -->
          <div class="hk-photo-col">
            {h.media.length > 0 ? (
              <div class="hk-gallery" id={`gal-${h.id}`}>
                <div class="hk-main-wrap">
                  <img
                    class="hk-main-img"
                    src={h.media[0].src}
                    alt={h.media[0].alt ?? h.title}
                    loading={i === 0 ? 'eager' : 'lazy'}
                  />
                </div>
                {h.media.length > 1 && (
                  <div class="hk-thumbs">
                    {h.media.map((m, mi) => (
                      <button
                        class={`hk-thumb ${mi === 0 ? 'active' : ''}`}
                        data-src={m.src}
                        data-gal={`gal-${h.id}`}
                        aria-label={m.alt ?? `Photo ${mi+1}`}
                      >
                        <img src={m.src} alt="" loading="lazy" />
                      </button>
                    ))}
                  </div>
                )}
              </div>
            ) : (
              <div class="hk-no-photo">
                <span class="hk-no-icon">▣</span>
                <span class="hk-no-txt">// fotos próximamente</span>
              </div>
            )}
          </div>

          <!-- RIGHT: info -->
          <div class="hk-info-col">
            <div class="hk-meta">
              <span class="hk-date">{h.date}</span>
              {h.tags.map(t => <span class="hk-tag">{t}</span>)}
            </div>

            <h2 class="hk-title">{h.title}</h2>
            <p class="hk-org">{h.org}</p>
            <p class="hk-desc">{h.desc}</p>

            {h.highlight && (
              <div class="hk-hl">
                <span class="hk-hlarr">→</span>
                <span>{h.highlight}</span>
              </div>
            )}

            {h.links.length > 0 && (
              <div class="hk-links">
                {h.links.map(l => (
                  <a href={l.href} target="_blank" rel="noopener" class="hk-link">{l.label} ↗</a>
                ))}
              </div>
            )}
          </div>

        </div>
      </div>
    ))}
  </div>

  <!-- Bottom dots -->
  <div class="hk-dots">
    {hackathons.map((_, i) => (
      <button class={`hk-dot ${i === 0 ? 'active' : ''}`} data-i={i} aria-label={`Hackathon ${i+1}`} />
    ))}
  </div>

</div>

<style>
  .hk-shell {
    width: 100%;
    font-family: var(--font);
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  /* ── Nav bar ── */
  .hk-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--border);
  }

  .hk-prompt { font-size: 12px; display: flex; align-items: center; }
  .hk-u  { color: var(--accent); font-weight: 600; }
  .hk-s  { color: var(--muted); }
  .hk-c  { color: var(--text-dim); }

  .hk-nav-right {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .hk-arr-btn {
    width: 30px; height: 30px;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: var(--bg-card);
    color: var(--text-dim);
    font-size: 13px;
    cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    font-family: var(--font);
    transition: all 0.15s;
  }
  .hk-arr-btn:hover:not(:disabled) {
    border-color: var(--accent-dim);
    color: var(--accent);
    background: var(--accent-subtle);
  }
  .hk-arr-btn:disabled { opacity: 0.2; cursor: default; }

  .hk-counter { font-size: 12px; color: var(--muted); display: flex; gap: 2px; }
  #hkCur { color: var(--text); font-weight: 600; }
  .hk-csep { color: var(--border-hi); }

  /* ── Slides container ── */
  .hk-slides {
    position: relative;
    width: 100%;
  }

  .hk-slide {
    display: none;
    animation: hkFadeIn 0.3s ease;
  }
  .hk-slide.active { display: block; }

  @keyframes hkFadeIn {
    from { opacity: 0; transform: translateX(20px); }
    to   { opacity: 1; transform: translateX(0); }
  }

  /* ── Card: two columns ── */
  .hk-card {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
    background: var(--bg-card);
    min-height: 360px;
  }

  /* ── Photo column ── */
  .hk-photo-col {
    background: var(--term-bg);
    display: flex;
    flex-direction: column;
  }

  .hk-gallery {
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .hk-main-wrap {
    flex: 1;
    overflow: hidden;
    min-height: 200px;
  }

  .hk-main-img {
    width: 100%; height: 100%;
    object-fit: contain;
    display: block;
    transition: opacity 0.2s;
  }

  /* Thumbs strip */
  .hk-thumbs {
    display: flex;
    gap: 5px;
    padding: 8px;
    background: rgba(0,0,0,0.35);
    overflow-x: auto;
    scrollbar-width: none;
    flex-shrink: 0;
  }
  .hk-thumbs::-webkit-scrollbar { display: none; }

  .hk-thumb {
    flex-shrink: 0;
    width: 48px; height: 48px;
    border-radius: 4px;
    overflow: hidden;
    border: 2px solid transparent;
    cursor: pointer; padding: 0;
    opacity: 0.5;
    transition: opacity 0.15s, border-color 0.15s;
    background: transparent;
  }
  .hk-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .hk-thumb.active { opacity: 1; border-color: var(--accent); }
  .hk-thumb:hover  { opacity: 0.8; }

  /* No photo */
  .hk-no-photo {
    flex: 1;
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    gap: 10px; min-height: 360px;
  }
  .hk-no-icon { font-size: 28px; color: #3a3a38; }
  .hk-no-txt  { font-size: 11px; color: #5a5a56; }

  /* ── Info column ── */
  .hk-info-col {
    padding: 28px 28px 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    justify-content: center;
  }

  .hk-meta { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }

  .hk-date {
    font-size: 11px; color: var(--muted);
    letter-spacing: 0.5px; flex-shrink: 0;
  }

  .hk-tag {
    font-size: 10px; color: var(--text-dim);
    background: var(--bg-panel);
    border: 1px solid var(--border);
    padding: 2px 7px; border-radius: 3px;
  }

  .hk-title {
    font-size: 22px; font-weight: 700;
    color: var(--text); letter-spacing: -0.5px; line-height: 1.2;
  }

  .hk-org { font-size: 12px; color: var(--muted); margin-top: -4px; }

  .hk-desc {
    font-size: 13px; color: var(--text-dim);
    line-height: 1.7;
  }

  .hk-hl {
    display: flex; gap: 8px; align-items: flex-start;
    font-size: 12px; color: var(--accent-dim);
    background: var(--accent-subtle);
    border-left: 2px solid var(--accent);
    padding: 8px 12px; border-radius: 0 4px 4px 0;
    line-height: 1.5;
  }
  .hk-hlarr { color: var(--accent); flex-shrink: 0; }

  .hk-links { display: flex; gap: 14px; }

  .hk-link {
    font-size: 12px; color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid var(--accent-dim);
    transition: opacity 0.15s;
  }
  .hk-link:hover { opacity: 0.7; text-decoration: none; }

  /* ── Bottom dots ── */
  .hk-dots {
    display: flex; justify-content: center; gap: 8px;
  }

  .hk-dot {
    width: 28px; height: 3px;
    border-radius: 2px; border: none;
    background: var(--border-hi);
    cursor: pointer; padding: 0;
    transition: background 0.2s, width 0.2s;
  }
  .hk-dot.active { background: var(--accent); width: 42px; }

  /* ── Mobile ── */
  @media (max-width: 768px) {
    .hk-card {
      grid-template-columns: 1fr;
      min-height: 0;
    }

    .hk-photo-col { min-height: 220px; max-height: 260px; }
    .hk-no-photo  { min-height: 220px; }

    .hk-info-col {
      padding: 18px 16px;
      gap: 8px;
    }

    .hk-title { font-size: 18px; }
    .hk-desc  { font-size: 12px; }

    .hk-thumb { width: 40px; height: 40px; }
  }
</style>

<script>
  const slides  = document.querySelectorAll<HTMLElement>('.hk-slide');
  const dots    = document.querySelectorAll<HTMLElement>('.hk-dot');
  const prevBtn = document.getElementById('hkPrev') as HTMLButtonElement;
  const nextBtn = document.getElementById('hkNext') as HTMLButtonElement;
  const curEl   = document.getElementById('hkCur')!;
  let cur = 0;

  function goTo(n: number) {
    if (n < 0 || n >= slides.length || n === cur) return;
    slides[cur].classList.remove('active');
    cur = n;
    slides[cur].classList.add('active');
    dots.forEach((d, i) => d.classList.toggle('active', i === cur));
    curEl.textContent = String(cur + 1).padStart(2, '0');
    prevBtn.disabled = cur === 0;
    nextBtn.disabled = cur === slides.length - 1;
  }

  prevBtn.addEventListener('click', () => goTo(cur - 1));
  nextBtn.addEventListener('click', () => goTo(cur + 1));
  dots.forEach((d, i) => d.addEventListener('click', () => goTo(i)));

  // Swipe support
  let startX = 0;
  const container = document.getElementById('hkSlides')!;
  container.addEventListener('touchstart', e => { startX = e.touches[0].clientX; }, { passive: true });
  container.addEventListener('touchend', e => {
    const diff = startX - e.changedTouches[0].clientX;
    if (Math.abs(diff) > 50) goTo(diff > 0 ? cur + 1 : cur - 1);
  });

  // Keyboard (only when section is visible)
  document.addEventListener('keydown', e => {
    const section = document.getElementById('hackathons');
    if (!section) return;
    const rect = section.getBoundingClientRect();
    if (rect.top > 100 || rect.bottom < 0) return;
    if (e.key === 'ArrowLeft')  goTo(cur - 1);
    if (e.key === 'ArrowRight') goTo(cur + 1);
  });

  prevBtn.disabled = true;
  nextBtn.disabled = slides.length <= 1;

  // Thumbnail clicks
  document.querySelectorAll<HTMLButtonElement>('.hk-thumb').forEach(thumb => {
    thumb.addEventListener('click', () => {
      const galId = thumb.getAttribute('data-gal')!;
      const src   = thumb.getAttribute('data-src')!;

      document.querySelectorAll<HTMLButtonElement>(`.hk-thumb[data-gal="${galId}"]`)
        .forEach(t => t.classList.remove('active'));
      thumb.classList.add('active');

      const mainImg = document.querySelector<HTMLImageElement>(`#${galId} .hk-main-img`);
      if (mainImg) {
        mainImg.style.opacity = '0';
        setTimeout(() => { mainImg.src = src; mainImg.style.opacity = '1'; }, 150);
      }
    });
  });
</script>