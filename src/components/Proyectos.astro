---
interface MediaItem {
  type: 'img' | 'video';
  src: string;
  alt?: string;
}

interface Project {
  id: string;
  label: string;
  status: string;
  title: string;
  org: string;
  desc: string;
  highlight: string;
  tags: string[];
  links: { label: string; href: string }[];
  media: MediaItem[];
}

const projects: Project[] = [
  {
    id: "hackupc",
    label: "hackathon",
    status: "",
    title: "?",
    org: "HackUPC 2026 · ? Challenge",
    desc: "Coming soon...",
    highlight: "",
    tags: ["?", "?", "?"],
    links: [{ label: "repo ↗", href: "#" }],
    media: [
      // { type: "img", src: "/media/hackupc-1.png", alt: "UI" },
    ],
  },
  {
    id: "lerobot",
    label: "hackathon",
    status: "done",
    title: "LE-PICASSO",
    org: "NVIDIA-LeRobot Bilbao 2026",
    desc: "The project allowed users to give voice commands through a web application. An AI model processed the audio, extracted instructions using Named Entity Recognition (NER), and sent them to a robotic arm, which then executed the commands by drawing the requested object.",
    highlight: "Each teammate participated in every aspect of the project.",
    tags: ["NER", "LeRobot arms", "Robotics", "Webapp", "Simulation"],
    links: [
    { label: "repo", href: "https://github.com/vasileandreipopan/lePicasso" },
    { label: "video", href: "https://www.youtube.com/watch?v=32cV6rU5I34" },
    ],
    media: [
      { type: "img", src: "/media/lerobot.png", alt: "Presentation" },
      { type: "img", src: "/media/lerobot2.jpg", alt: "Random photo" },
      { type: "img", src: "/media/lerobot3.jpg", alt: "Random photo-2" },
    ],
  },
  {
    id: "nasa-exoplanets",
    label: "hackathon",
    status: "done",
    title: "Rookie Rockets: Exovision",
    org: "NASA Space Apps Challenge 2025",
    desc: "Web platform powered by an AI model to detect exoplanets using NASA’s Kepler dataset. It includes an 'Educational' mode with interactive visualizations designed for the general public to understand how exoplanet detection works and a 'Professional' mode where researchers can upload and analyze real light curves using our trained model.",
    highlight: "During the development, as coordinator and full-stack contributor, I worked across AI, frontend, and project direction.",
    tags: ["Python", "ML", "NASA Kepler Data", "Data Viz", "React"],
    links: [{ label: "+info", href: "https://www.spaceappschallenge.org/2025/find-a-team/rookie-rockets/" }],
    media: [
      { type: "img", src: "/media/nasaHackathon-team.jpeg", alt: "team" },
      { type: "img", src: "/media/decodeNasaHackathon.jpeg", alt: "Decode" },
      { type: "img", src: "/media/presentationNasa.jpeg", alt: "Presentation" },
    ],
  },
  {
    id: "hackupc",
    label: "hackathon",
    status: "done",
    title: "Travel Recommender",
    org: "HackUPC 2024 · Skyscanner Challenge",
    desc: "We developed a web application that addresses the challenge proposed by Skyscanner, helping groups of friends find the perfect travel destination by considering their preferences, budget and sustainability.",
    highlight: "This is special because it was my first hackathon project!!",
    tags: ["HTML-CSS-JS", "Java", "API Integration"],
    links: [{ label: "repo", href: "https://github.com/pablo10diez2/hackupc" }],
    media: [
      { type: "img", src: "/media/hackupc2025.jpeg", alt: "UI" },
    ],
  },
];
---

<div class="pv-shell">

  <!-- VIEWER -->
  <div class="pv-stage">

    <!-- Prev -->
    <button class="pv-arrow pv-prev" id="pvPrev" aria-label="Anterior" disabled>←</button>

    <!-- Cards -->
    <div class="pv-cards" id="pvCards">
      {projects.map((p, i) => (
        <div class={`pv-card ${i === 0 ? 'active' : ''}`} data-index={i}>

          <!-- LEFT: media -->
          <div class="pv-media">
            <!-- header overlay -->
            <div class="pv-media-header">
              <span class="pv-prompt">
                <span class="pu">admin</span>
                <span class="ps"> : ~ $ </span>
                <span class="pc"> ls proyectos/</span>
              </span>
              <span class="pv-counter">
                <span class="pv-cur" id={i === 0 ? 'pvCur' : undefined}>
                  {String(i + 1).padStart(2, '0')}
                </span>
                <span class="pv-sep">/</span>
                <span>{String(projects.length).padStart(2, '0')}</span>
              </span>
            </div>

            {p.media.length > 0 ? (
              <div class="pv-carousel" id={`carousel-${p.id}`}>
                <div class="pv-track">
                  {p.media.map((m) => (
                    <div class="pv-media-item">
                      {m.type === 'img' && <img src={m.src} alt={m.alt ?? p.title} loading="lazy" />}
                      {m.type === 'video' && <video src={m.src} muted playsinline controls />}
                    </div>
                  ))}
                </div>
                {p.media.length > 1 && (
                  <div class="pv-dots">
                    {p.media.map((_, mi) => (
                      <button class={`pv-dot ${mi === 0 ? 'active' : ''}`} data-mi={mi} />
                    ))}
                  </div>
                )}
              </div>
            ) : (
              <div class="pv-placeholder">
                <span class="ph-icon">▣</span>
                <span class="ph-text">// Images coming soon</span>
              </div>
            )}
          </div>

          <!-- RIGHT: info -->
          <div class="pv-info">
            <div class="pv-badges">
              <span class="pv-badge">{p.label}</span>
              {p.status === 'WIP' && <span class="pv-badge pv-badge--wip">en curso</span>}
              <span class="pv-org">{p.org}</span>
            </div>

            <h2 class="pv-title">{p.title}</h2>
            <p class="pv-desc">{p.desc}</p>

            <div class="pv-highlight">
              <span class="pv-arrow-icon">→</span>
              <span>{p.highlight}</span>
            </div>

            <div class="pv-footer">
              <div class="pv-tags">
                {p.tags.map(t => <span class="pv-tag">{t}</span>)}
              </div>
              <div class="pv-links">
                {p.links.map(l => (
                  <a href={l.href} target="_blank" rel="noopener" class="pv-link">{l.label}</a>
                ))}
              </div>
            </div>
          </div>

        </div>
      ))}
    </div>

    <!-- Next -->
    <button class="pv-arrow pv-next" id="pvNext" aria-label="Siguiente">→</button>

  </div>

  <!-- Bottom dots -->
  <div class="pv-bottom-dots" id="pvBottomDots">
    {projects.map((_, i) => (
      <button class={`pvd ${i === 0 ? 'active' : ''}`} data-i={i} />
    ))}
  </div>

</div>

<style>
  /* ── Shell ── */
  .pv-shell {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }

  /* ── Stage ── */
  .pv-stage {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
  }

  /* ── Arrow buttons ── */
  .pv-arrow {
    flex-shrink: 0;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: var(--bg-card);
    color: var(--text-dim);
    font-size: 14px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font);
    transition: all 0.15s;
  }
  .pv-arrow:hover:not(:disabled) {
    border-color: var(--accent-dim);
    color: var(--accent);
    background: var(--accent-subtle);
  }
  .pv-arrow:disabled { opacity: 0.2; cursor: default; }

  /* ── Cards container ── */
  .pv-cards {
    flex: 1;
    position: relative;
    height: 460px;
    overflow: hidden;
    border-radius: 8px;
  }

  /* ── Single card ── */
  .pv-card {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: row;
    border-radius: 8px;
    overflow: hidden;
    opacity: 0;
    transform: translateX(32px);
    transition: opacity 0.3s ease, transform 0.3s ease;
    pointer-events: none;
    box-shadow: 0 8px 32px rgba(0,0,0,0.10);
  }
  .pv-card.active {
    opacity: 1;
    transform: translateX(0);
    pointer-events: all;
  }

  /* ── LEFT: media ── */
  .pv-media {
    width: 48%;
    flex-shrink: 0;
    background: var(--term-bg);
    position: relative;
    overflow: hidden;
  }

  /* Header overlay on media */
  .pv-media-header {
    position: absolute;
    top: 0; left: 0; right: 0;
    z-index: 10;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 14px;
    background: linear-gradient(to bottom, rgba(25,25,23,0.95) 60%, transparent);
    font-family: var(--font);
    font-size: 11px;
    pointer-events: none;
  }

  .pv-prompt { display: flex; gap: 0; }
  .pu { color: var(--term-green); font-weight: 600; }
  .ps { color: var(--term-dim); }
  .pc { color: var(--term-text); }

  .pv-counter { color: var(--term-dim); display: flex; gap: 3px; }
  .pv-cur { color: var(--term-text); font-weight: 600; }
  .pv-sep { color: var(--term-border-hi); }

  /* Carousel */
  .pv-carousel { width: 100%; height: 100%; position: relative; }
  .pv-track {
    display: flex;
    height: 100%;
    transition: transform 0.15s ease;
  }
  .pv-media-item {
    flex-shrink: 0;
    width: 100%;
    height: 100%;
    background: var(--term-bg);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .pv-media-item img,
  .pv-media-item video {
    width: 100%; height: 100%;
    object-fit: contain;
    display: block;
    background: var(--term-bg);
  }

  .pv-dots {
    position: absolute;
    bottom: 10px; left: 50%;
    transform: translateX(-50%);
    display: flex; gap: 5px;
  }
  .pv-dot {
    width: 5px; height: 5px;
    border-radius: 50%;
    border: none;
    background: rgba(255,255,255,0.3);
    cursor: pointer; padding: 0;
    transition: background 0.2s;
  }
  .pv-dot.active { background: rgba(255,255,255,0.9); }

  /* Placeholder */
  .pv-placeholder {
    width: 100%; height: 100%;
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    gap: 8px; padding-top: 40px;
  }
  .ph-icon { font-size: 24px; color: var(--term-border-hi); }
  .ph-text { font-size: 11px; color: var(--term-dim); font-family: var(--font); }
  .ph-sub  { font-size: 10px; color: var(--term-border-hi); font-family: var(--font); }

  /* ── RIGHT: info ── */
  .pv-info {
    flex: 1;
    background: var(--bg-card);
    border-left: 1px solid var(--border);
    padding: 24px 24px 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    overflow: hidden;
  }

  .pv-badges {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }

  .pv-badge {
    font-size: 10px;
    font-family: var(--font);
    color: var(--muted);
    background: var(--bg-panel);
    border: 1px solid var(--border);
    padding: 2px 7px;
    border-radius: 3px;
    text-transform: uppercase;
    letter-spacing: 0.8px;
  }
  .pv-badge--wip {
    color: var(--accent);
    background: var(--accent-subtle);
    border-color: var(--accent-dim);
    text-transform: none;
    letter-spacing: 0;
  }

  .pv-org {
    font-size: 11px;
    color: var(--text-dim);
    font-family: var(--font);
  }

  .pv-title {
    font-size: 18px;
    font-weight: 700;
    color: var(--text);
    font-family: var(--font);
    letter-spacing: -0.4px;
    line-height: 1.25;
  }

  .pv-desc {
    font-size: 12px;
    color: var(--text-dim);
    font-family: var(--font);
    line-height: 1.7;
    flex: 1;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 5;
    -webkit-box-orient: vertical;
  }

  .pv-highlight {
    display: flex;
    gap: 7px;
    align-items: flex-start;
    font-size: 11px;
    color: var(--accent-dim);
    background: var(--accent-subtle);
    border-left: 2px solid var(--accent);
    padding: 8px 12px;
    border-radius: 0 4px 4px 0;
    font-family: var(--font);
    line-height: 1.5;
    flex-shrink: 0;
  }
  .pv-arrow-icon { color: var(--accent); flex-shrink: 0; }

  .pv-footer {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 8px;
    flex-shrink: 0;
  }

  .pv-tags { display: flex; flex-wrap: wrap; gap: 4px; }
  .pv-tag {
    font-size: 10px;
    font-family: var(--font);
    color: var(--text-dim);
    background: var(--bg-panel);
    border: 1px solid var(--border);
    padding: 2px 7px;
    border-radius: 3px;
  }

  .pv-links { display: flex; gap: 8px; }
  .pv-link {
    font-size: 11px;
    font-family: var(--font);
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid var(--accent-dim);
  }
  .pv-link:hover { opacity: 0.7; text-decoration: none; }

  /* ── Bottom dots ── */
  .pv-bottom-dots {
    display: flex;
    gap: 8px;
  }
  .pvd {
    width: 28px; height: 3px;
    border-radius: 2px; border: none;
    background: var(--border-hi);
    cursor: pointer; padding: 0;
    transition: background 0.2s, width 0.2s;
  }
  .pvd.active {
    background: var(--accent);
    width: 42px;
  }

  /* ── Mobile ── */
  @media (max-width: 768px) {
    .pv-shell { gap: 12px; }

    /* Stack card vertically on mobile */
    .pv-card {
      flex-direction: column;
      height: auto;
    }

    /* Cards container: auto height on mobile */
    .pv-cards {
      height: auto;
      min-height: 0;
    }

    /* Media takes full width, fixed height */
    .pv-media {
      width: 100%;
      height: 220px;
      flex-shrink: 0;
    }

    /* Info area: normal flow */
    .pv-info {
      padding: 16px;
      gap: 10px;
      height: auto;
    }

    .pv-title { font-size: 16px; }
    .pv-desc  { font-size: 11px; -webkit-line-clamp: 4; }

    /* Arrows: smaller, tighter */
    .pv-arrow {
      width: 28px;
      height: 28px;
      font-size: 12px;
    }

    .pv-stage { gap: 6px; }

    /* Dots row */
    .pv-bottom-dots { gap: 6px; }
    .pvd { width: 22px; }
    .pvd.active { width: 34px; }
  }

</style>

<script>
  const cards    = document.querySelectorAll<HTMLElement>('.pv-card');
  const bdots    = document.querySelectorAll<HTMLElement>('.pvd');
  const prevBtn  = document.getElementById('pvPrev') as HTMLButtonElement;
  const nextBtn  = document.getElementById('pvNext') as HTMLButtonElement;
  const curEl    = document.getElementById('pvCur')!;
  let cur = 0;

  function goTo(next: number) {
    if (next < 0 || next >= cards.length || next === cur) return;
    const dir = next > cur ? 1 : -1;

    // out
    const outCard = cards[cur];
    outCard.style.transition = 'opacity 0.28s ease, transform 0.28s ease';
    outCard.style.opacity = '0';
    outCard.style.transform = `translateX(${-dir * 36}px)`;
    outCard.style.pointerEvents = 'none';

    cur = next;
    const inCard = cards[cur];

    // position in off-screen
    inCard.style.transition = 'none';
    inCard.style.opacity = '0';
    inCard.style.transform = `translateX(${dir * 36}px)`;
    inCard.style.pointerEvents = 'none';

    inCard.getBoundingClientRect(); // reflow

    inCard.style.transition = 'opacity 0.28s ease, transform 0.28s ease';
    inCard.style.opacity = '1';
    inCard.style.transform = 'translateX(0)';
    inCard.style.pointerEvents = 'all';

    setTimeout(() => {
      outCard.classList.remove('active');
      outCard.style.cssText = '';
      inCard.classList.add('active');
      inCard.style.cssText = '';
    }, 300);

    // update UI
    bdots.forEach((d, i) => d.classList.toggle('active', i === cur));
    curEl.textContent = String(cur + 1).padStart(2, '0');
    prevBtn.disabled = cur === 0;
    nextBtn.disabled = cur === cards.length - 1;
  }

  prevBtn.addEventListener('click', () => goTo(cur - 1));
  nextBtn.addEventListener('click', () => goTo(cur + 1));
  bdots.forEach((d, i) => d.addEventListener('click', () => goTo(i)));

  document.addEventListener('keydown', e => {
    if (e.key === 'ArrowLeft')  goTo(cur - 1);
    if (e.key === 'ArrowRight') goTo(cur + 1);
  });

  prevBtn.disabled = true;
  nextBtn.disabled = cards.length <= 1;

  // ── Carousel autoplay per card ──
  document.querySelectorAll<HTMLElement>('.pv-carousel').forEach(carousel => {
    const track = carousel.querySelector<HTMLElement>('.pv-track')!;
    const dots  = carousel.querySelectorAll<HTMLElement>('.pv-dot');
    let mc = 0;

    function mGoTo(n: number) {
      mc = n;
      track.style.transform = `translateX(-${n * 100}%)`;
      dots.forEach((d, i) => d.classList.toggle('active', i === n));
    }

    dots.forEach((d, i) => d.addEventListener('click', () => mGoTo(i)));

    if (dots.length > 1) {
      let t = setInterval(() => mGoTo((mc + 1) % dots.length), 2000);
      carousel.addEventListener('mouseenter', () => clearInterval(t));
      carousel.addEventListener('mouseleave', () => {
        t = setInterval(() => mGoTo((mc + 1) % dots.length), 2000);
      });
    }
  });
</script>