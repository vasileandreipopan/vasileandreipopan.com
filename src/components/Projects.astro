---
const projects = [
  {
    num: '001',
    title: 'k8s AI Runbook',
    year: '2026',
    href: 'https://github.com/vasileandreipopan/ct_ai_k8s_runbook',
    desc: 'Kubernetes Runbook Assistant built on Cloudflare Workers AI. Describe a Kubernetes alert in plain English and get step-by-step remediation powered by Llama 3.3 70B. Conversation history persisted via Durable Objects.',
    stack: ['TypeScript', 'Cloudflare Workers', 'Llama 3.3 70B', 'Durable Objects'],
  },
  {
    num: '002',
    title: 'Docker Production Stack',
    year: '2026',
    href: 'https://github.com/vasileandreipopan/docker-production-stack',
    desc: 'Production-style containerised platform: FastAPI, PostgreSQL, Nginx, Prometheus, and Grafana — networked via Docker Compose. Multi-stage Dockerfile, non-root user, healthchecks. Fully reproducible from one command.',
    stack: ['Docker', 'FastAPI', 'PostgreSQL', 'Nginx', 'Prometheus', 'Grafana'],
  },
  {
    num: '003',
    title: 'Crypto Course',
    year: '2025',
    href: 'https://github.com/vasileandreipopan/crypto-course-0xdecode',
    desc: 'Introduction to cryptography workshop prepared for the 0xdecode community. Covers core concepts, hands-on exercises, and real-world applications — designed to be accessible to people just getting into security.',
    stack: ['Cryptography', 'CTF', 'Workshop', '0xdecode'],
  },
  {
    num: '004',
    title: 'Gym Routine App',
    year: '2025',
    href: 'https://github.com/vasileandreipopan/Gym-Routine-App',
    desc: 'Web app where users can build and manage their own gym routines, and browse routines shared by the community. Full CRUD, user accounts, and a public feed of routines.',
    stack: ['Web', 'Full Stack', 'CRUD', 'Community'],
  },
];
---
<section id="projects" class="section">

  <div class="spacer"></div>

  <span class="sec-label">Projects</span>

  <div class="projects-list">
    {projects.map((p, i) => (
      <div class="project reveal" style={`transition-delay:${i*0.08}s`}>
        <div class="project-top">
          <span class="project-num mono">{p.num}</span>
          <div class="project-title-wrap">
            <h3 class="project-title">{p.title}</h3>
            <span class="project-year mono">{p.year}</span>
          </div>
        </div>
        <p class="project-desc">{p.desc}</p>
        <div class="project-links mono">
          <a href={p.href} target="_blank" rel="noopener">GitHub →</a>
        </div>
        <p class="project-stack mono">{p.stack.join(' · ')}</p>
      </div>
    ))}
  </div>

  <div class="spacer"></div>

</section>

<style>
  .projects-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.75rem 3rem;
  }

  .project {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding-bottom: 1.75rem;
    border-bottom: 1px solid var(--light);
  }

  .project:nth-last-child(-n+2) {
    border-bottom: none;
    padding-bottom: 0;
  }

  .project-top {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }

  .project-num {
    font-size: 0.62rem;
    color: var(--dark);
    flex-shrink: 0;
  }

  .project-title-wrap {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .project-title {
    font-family: var(--font-sys);
    font-size: 0.95rem;
    font-weight: bold;
  }

  .project-links {
    display: flex;
    gap: 1.25rem;
    font-size: 0.68rem;
  }
  .project-links a { color: var(--dark); }

  .project-year {
    font-size: 0.65rem;
    color: var(--dark);
  }

  .project-desc {
    font-size: 0.85rem;
    line-height: 1.7;
    color: var(--black);
  }

  .project-stack {
    font-size: 0.68rem;
    color: var(--dark);
  }

  @media (max-width: 580px) {
    .projects-list { grid-template-columns: 1fr; }
    .project:nth-last-child(-n+2) { border-bottom: 1px solid var(--light); padding-bottom: 1.75rem; }
    .project:last-child { border-bottom: none; padding-bottom: 0; }
  }
</style>