---
const projects = [
  {
    num:   '001',
    title: 'Docker Production Stack',
    year:  '2026',
    href:  'https://github.com/vasileandreipopan',
    desc:  'Production-style containerised platform: FastAPI, PostgreSQL, Nginx, Prometheus, and Grafana — networked via Docker Compose. Multi-stage Dockerfile, non-root user, healthchecks. Fully reproducible from one command.',
    stack: ['Docker', 'FastAPI', 'PostgreSQL', 'Nginx', 'Prometheus', 'Grafana'],
  },
  {
    num:   '002',
    title: 'LeRobot Bilbao',
    year:  '2025',
    href:  'https://github.com/vasileandreipopan',
    desc:  'Voice-controlled robotic arm. Spoken commands → web app → NER model extracts drawing instructions → physical robot executes them. Built at the NVIDIA Hackathon.',
    stack: ['Python', 'AI/ML', 'NER', 'Robotics'],
  },
  {
    num:   '003',
    title: 'Exoplanet Detection',
    year:  '2025',
    href:  'https://github.com/vasileandreipopan',
    desc:  'AI/ML platform for exoplanet detection from NASA Kepler light curve data. Public visualisations + professional research interface to upload and classify real data. NASA Space Apps.',
    stack: ['Python', 'AI/ML', 'NASA Kepler', 'Data Viz'],
  },
];
---
<section id="projects" class="section">

  <span class="sec-label">Projects</span>

  <div class="projects-list">
    {projects.map((p, i) => (
      <div class="project reveal" style={`transition-delay:${i*0.1}s`}>
        <div class="project-top">
          <span class="project-num mono">{p.num}</span>
          <div class="project-title-wrap">
            <h3 class="project-title">
              <a href={p.href} target="_blank" rel="noopener">{p.title}</a>
            </h3>
            <span class="project-year mono">{p.year}</span>
          </div>
        </div>
        <p class="project-desc">{p.desc}</p>
        <div class="project-stack mono">
          {p.stack.map((s, i) => (
            <span>{s}{i < p.stack.length - 1 ? ' · ' : ''}</span>
          ))}
        </div>
      </div>
    ))}
  </div>

  <div class="spacer"></div>

</section>

<style>
  .projects-list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .project-top {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 0.5rem;
  }

  .project-num {
    font-size: 0.65rem;
    color: var(--dark);
    flex-shrink: 0;
  }

  .project-title-wrap {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .project-title {
    font-family: var(--font-sys);
    font-size: 1rem;
    font-weight: bold;
  }

  .project-title a { color: var(--black); text-decoration: none; }
  .project-title a:hover { background: var(--black); color: var(--white); }

  .project-year {
    font-size: 0.68rem;
    color: var(--dark);
  }

  .project-desc {
    font-size: 0.9rem;
    line-height: 1.7;
    color: var(--black);
    max-width: 640px;
    margin-bottom: 0.5rem;
  }

  .project-stack {
    font-size: 0.7rem;
    color: var(--dark);
  }
</style>